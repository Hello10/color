{
	"name": "@hello10/color",
	"version": "2.0.0",
	"description": "Color class and conversion utilities — rgb / hsl / hsv / hex / css / named colors",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Stephen Handley",
		"email": "stephen@hello10.com",
		"url": "https://hello10.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Hello10/color.git"
	},
	"keywords": [
		"color",
		"rgb",
		"hsl",
		"hsv",
		"hex",
		"css",
		"named-colors"
	],
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint",
		"prepublishOnly": "pnpm run build",
		"clean": "rm -rf dist node_modules"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hello10/etc": "^1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@hello10/config-biome": "^1.0.0",
		"@hello10/config-typescript": "^1.0.0",
		"@types/node": "^26.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.20.0"
}
