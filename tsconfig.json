{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@hello10/config-typescript/base",
	"compilerOptions": {
		"lib": ["ES2022"],
		"emitDeclarationOnly": false,
		"noEmit": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["src", "test"]
}
